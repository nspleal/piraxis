# ---------------------------------------------------------------------------
# Modelo de configuração opcional do PIRAXIS (extrator de radiação solar, UNESP).
#
# IMPORTANTE: o e-mail da sua conta SoDa (CAMS McClear) NÃO fica aqui.
# Ele é individual de cada pesquisador e é gerido por máquina, salvo em
# ~/.radiacao_solar/config.json (veja core/credenciais.py). Nunca coloque
# e-mail nem segredos neste arquivo.
#
# Para usar: copie este arquivo para ".env" e ajuste se desejar.
# ---------------------------------------------------------------------------

# Habilita (true) ou desabilita (false) o cache local de respostas das APIs.
# Padrão: true. Com o cache ligado, repetir a mesma extração não bate na API.
CACHE_HABILITADO=true
